# Python
.venv/
.venv-win/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ansible
*.retry
collections/ansible_collections/
roles/galaxy/
.vault_pass
.vault_pass.txt
# Plaintext secret staging under vault/ — never commit; encrypt to *.vault.yml instead
vault/*.plain.yml
.tmp_controller_ssh
.tmp_controller_ssh.pub
.facts_cache/
inventory/facts/
.ansible/

# Terraform provider/plugin cache (rare here; keep consistent with global ignore)
**/.terraform/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/*
!logs/.gitkeep
!logs/README.md
!logs/runs/
logs/runs/*
!logs/runs/.gitkeep
artifacts/troubleshooting/*
!artifacts/troubleshooting/.gitkeep
artifacts/backupsets/*
!artifacts/backupsets/.gitkeep
artifacts/netbox-service-inventory/*
!artifacts/netbox-service-inventory/.gitkeep
artifacts/netbox-reconciliation/*
!artifacts/netbox-reconciliation/.gitkeep
playbooks/troubleshoot/artifacts/
playbooks/*-artifact-*.json
playbooks/mac/*-artifact-*.json

# Temporary files
*.tmp
*.bak
*.zip
private/tunnelblick/*
!private/tunnelblick/.gitkeep
!private/tunnelblick/README.md

# OpenSSH host keys (private); drop from Mac into bootstrap/openssh_host_keys/
bootstrap/openssh_host_keys/*
!bootstrap/openssh_host_keys/README*

# Direnv files
.direnv/
.envrc
# vault.yml is ansible-vault encrypted and safe to commit — do not ignore it

# spurious dir created when Ansible extension fails to resolve ${workspaceFolder}
{workspaceFolder}/

# Homelab local caches (RDP certs, etc.)
.cache/

# Accidental hf download when --local-dir was printed with [] around the folder
exports/work-laptop-ai-tools/helpers/work-mac-local-models/\[/
.aider*

# Paired-agent evaluator loop runtime (do not commit; regenerate locally)
docs/plans/**/waiting_for_review_by_evaluator_*
docs/plans/**/feedback_for_review_by_evaluator_*
docs/plans/**/ready_for_review_by_evaluator_*
docs/plans/**/.evaluator-simple-*
docs/plans/**/.evaluator-*-launchd.*
docs/plans/**/.evaluator-*-loop.state
