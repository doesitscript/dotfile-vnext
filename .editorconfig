# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# PowerShell files
[*.ps1]
end_of_line = lf
insert_final_newline = true

# Shell scripts
[*.sh]
end_of_line = lf
insert_final_newline = true

# Markdown files
[*.md]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
end_of_line = lf
insert_final_newline = true

# JSON files
[*.json]
end_of_line = lf
insert_final_newline = true

# Text files
[*.txt]
end_of_line = lf
insert_final_newline = true

# Python files
[*.py]
end_of_line = lf
insert_final_newline = true

# JavaScript/TypeScript files
[*.{js,ts,jsx,tsx}]
end_of_line = lf
insert_final_newline = true

# XML/HTML files
[*.{xml,html}]
end_of_line = lf
insert_final_newline = true

# CSS files
[*.css]
end_of_line = lf
insert_final_newline = true

# Terraform files
[*.{tf,tfvars}]
end_of_line = lf
insert_final_newline = true
