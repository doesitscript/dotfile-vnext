# vault/shared.vault.yml - UPDATE INSTRUCTIONS
#
# ADD the following to the existing vault file:
#
# vault_server_225_win_password: "REAL_PASSWORD_HERE"
#
# This should be encrypted with ansible-vault. The bootstrap templates reference
# this variable but never write the actual password - only the variable name.
#
# Example addition (encrypted):
# ---
# # ... existing content ...
# 
# vault_server_225_win_password: "{{ vault_server_225_win_password }}"
#
# After adding, encrypt with:
# ansible-vault encrypt vault/shared.vault.yml
