{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshc/dotfile-vnext/skills/schemas/skills-catalog.v2.json",
  "title": "Project Skills Catalog v2",
  "type": "object",
  "required": ["schema_version", "description", "skills"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description",
          "path",
          "scope",
          "category",
          "purpose",
          "status",
          "triggers",
          "do_not_use_when",
          "handoff_from",
          "handoff_to",
          "complements",
          "references"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "description": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "const": "project" },
          "category": {
            "type": "string",
            "enum": ["documentation", "implementation", "validation"]
          },
          "purpose": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["draft", "reviewed", "deprecated"] },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "do_not_use_when": { "type": "array", "items": { "type": "string" } },
          "handoff_from": { "type": "array", "items": { "type": "string" } },
          "handoff_to": { "type": "array", "items": { "type": "string" } },
          "complements": { "type": "array", "items": { "type": "string" } },
          "references": { "type": "array", "items": { "type": "string" } },
          "runtime_bridge": { "type": "object" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "target_surface": { "type": "array", "items": { "type": "string" } },
          "default_for": { "type": "array", "items": { "type": "string" } },
          "preferred_prompt": { "type": "string" },
          "recommended_sequence": { "type": "array", "items": { "type": "string" } },
          "companion_skills": { "type": "array", "items": { "type": "string" } },
          "part_of_flows": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
