---
# Controller SSH key pair (generated by bootstrap/local; do not edit by hand).
# Other setups (e.g. Mac) load this vault and install vault_controller_ssh_private_key to use as SSH identity.
vault_controller_ssh_private_key: |
{{ controller_ssh_private_key_content | indent(2, first=true) }}
vault_controller_ssh_public_key: "{{ controller_ssh_public_key_content | trim }}"
