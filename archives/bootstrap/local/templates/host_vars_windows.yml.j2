# bootstrap/local/templates/host_vars_windows.yml.j2
# Template for Windows host_vars - secrets remain vault references

physical_node: "{{ physical_node }}"
surface_type: windows_host

host_ip: "{{ host_ip }}"
winrm_port: 5986
win_user: "{{ win_user }}"

# Keep the password as a vault variable reference only
# Define vault_server_225_win_password in vault/shared.vault.yml (encrypted)
win_password: "{{ win_password }}"
# WinRM NTLM requires one of these; mirror win_password so ad-hoc and playbook runs work
ansible_password: "{{ win_password }}"
ansible_winrm_password: "{{ win_password }}"

# Ansible connection settings
ansible_connection: winrm
ansible_host: "{{ host_ip }}"
ansible_user: "{{ win_user }}"
ansible_port: 5986
ansible_winrm_transport: ntlm
ansible_winrm_scheme: https
ansible_winrm_server_cert_validation: ignore
