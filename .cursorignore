# Files and directories excluded from Cursor's codebase indexing and AI access.
# Syntax matches .gitignore. Prefer listing high-noise / secret paths here even
# when they already appear in .gitignore — gitignore alone is indexing-oriented;
# .cursorignore also gates Agent / Tab / @ mentions.

# Cross-project brainstorming and external reference notes.
docs/brainstorming_designs/external_context/

# Python / Ansible runtime (large, not source of truth)
.venv/
__pycache__/
*.pyc
.facts_cache/
.ansible/
collections/ansible_collections/

# Archives and root navigator log
*.zip
ansible-navigator.log

# Cursor / skill capture logs under the IDE tree
.cursor/logs/
