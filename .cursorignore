# Cursor-only context/indexing exclusions.
# Plan: docs/plans/2026-09-23--large-ide-workspace-ai-context-evaluation/
# These files may remain tracked in Git/GitHub where policy requires it, but
# they are not normal AI source context. Explicitly named paths can still be
# investigated when the task requires them.

# Existing externalized runtime/evidence boundary.
logs/

# Download, extraction, and controller/runtime artifacts under playbooks.
playbooks/.cache/
playbooks/artifacts/
playbooks/troubleshoot/artifacts/

# Repository artifact trees.
artifacts/

# Generated or execution-only descendants anywhere in the workspace.
**/generated/
**/rendered/
**/runtime/
**/evidence/
**/coordination/
**/transcripts/

# High-noise generated/evidence file types.
**/*.log
**/*.zip
**/*.mhtml
**/*.dump
**/*.tar
**/*.tar.gz
