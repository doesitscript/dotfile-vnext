---
profile: production

# Third-party Galaxy roles are not linted — they are maintained upstream.
exclude_paths:
  - roles/galaxy/

skip_list:
  # Abbreviated internal register vars (_wb_, _aiw_, etc.) are the established
  # project convention. Role-prefix enforcement on registers is too verbose.
  - var-naming[no-role-prefix]
  # Conditional service stops (e.g. after install) are legitimate pre-handler
  # ordering steps, not handler candidates.
  - no-handler
  # Reference roles may target older Ansible versions
  - meta-runtime[unsupported-version]
  # Galaxy changelog not required for private home-lab roles
  - galaxy[no-changelog]
  # common/shell_config lives under roles/common/ subdirectory — established project
  # convention for grouping shared roles. Restructuring the path is out of scope.
  - role-name[path]
