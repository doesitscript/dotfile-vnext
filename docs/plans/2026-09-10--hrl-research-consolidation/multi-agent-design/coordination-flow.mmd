flowchart TB
    OP["Operator: source plan + separate output root"]
    UP["Future upstream intake<br/>pipeline_id + task_id + scoped handoff/hash"]
    ID["Attempt identity<br/>stage_id=preparation + run_id<br/>separate session_id + owner manifest"]
    RUNTIME["External orchestrator + reusable runtime operator<br/>dashboard http://127.0.0.1:7900<br/>setup, wakeups, recovery, owned cleanup"]
    SRC["Source plan + task-relevant project/HRL evidence"]
    subgraph PREP["Preparation outputs: preparation_output_root"]
        CO1["Coordinator: route"] --> RT["coordination/current-phase-routing.md"]
        RT --> RE["Researcher: research"] --> RB["research/current-phase-readiness-brief.md"]
        RB --> CO2["Coordinator: compose or revise"] --> HP["handoff/current-phase-implementation-plan.md"]
        HP --> REV["Researcher: independent evidence and coverage review"]
        REV --> REVIEW["research/current-phase-plan-review.md<br/>reviewed path + SHA-256"]
        REVIEW --> STATUS{"Plan review status"}
        STATUS -->|"changes required: bounded correction"| CO2
        STATUS -->|"passed: same run and current hash"| REL["Coordinator: release"]
        REL --> RELEASE["handoff/current-phase-release.md<br/>ready_for_implementation"]
    end
    OP --> RUNTIME
    UP -.->|"optional intake; authorized scope only"| OP
    OP --> ID --> RUNTIME
    RUNTIME -.->|"schedule each single-pass invocation"| PREP
    SRC --> CO1
    SRC --> RE
    SRC --> REV
    CO2 -->|"meaningful evidence gap"| RE
    CO2 -->|"unresolved user decision"| OP
    RELEASE --> PARENT["Return exact plan/review/hash to parent or operator<br/>preparation stops here"]
    PARENT -.->|"future stage; separate activation authority"| CANON["Canonical plan + evidence packet\nresearch, receipts, decisions, hashes"]
    CANON --> SYNTH["Research Synthesizer\nclassifies research guidance\nagainst current state and owners"]
    SYNTH --> EXPERT["Resident / On-site Expert\nchallenge and refine"]
    EXPERT -->|"bounded follow-up"| SYNTH
    CANON --> PROFILE{"Decision authority profile"}
    PROFILE -->|"lab_recreatable_autonomy"| IMPL["Established Implementer"]
    PROFILE -->|"product_governed"| IMPL
    CANON --> EVAL["Established Evaluator"]
    IMPL --> UNCERTAIN{"Bounded uncertainty?"}
    UNCERTAIN -->|"none"| HANDOFF["Review-ready receipt"] --> EVAL
    UNCERTAIN -->|"technical doubt"| EXPERT
    UNCERTAIN -->|"evidence gap"| RESEARCH["Targeted Researcher / capability refresh"] --> SYNTH
    EXPERT --> REC["Recommendation packet\nclass + evidence + best recommendation\nvalidation + rollback"]
    REC -->|"technical recommendation"| IMPL
    REC -->|"consequential decision"| PROFILE
    PROFILE -->|"lab: adopt evidence-backed default"| IMPL
    PROFILE -->|"product: human decision required"| OPDEC["Operator authority decision"] --> CANON
    IMPL -->|"source/runtime or safety contradiction"| EXCEPTION["Recorded exception / deviation"] --> EVAL
    EVAL -->|"defect"| IMPL
    EVAL -->|"evidence or recommendation conflict"| EXPERT
    EVAL -->|"accepted"| CLOSE["Closeout / reusable knowledge promotion"]
    RELEASE --> CLEAN["Coordinator: offer cleanup of exact leftovers<br/>retain skills, plan, handoff, and receipts"]
    CLEAN -->|"authorized cleanup"| RUNTIME
