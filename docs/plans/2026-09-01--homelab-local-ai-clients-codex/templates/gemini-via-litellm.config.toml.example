# Concurrent editing note: Codex owns this example; Cursor should not rewrite it.
# Install after vault_shared_gemini_api_key is set and deploy_litellm_gateway.yaml has run.
# Codex custom providers require the Responses API; verify LiteLLM exposes a Responses-compatible
# route before relying on this profile for codex exec.

model = "gemini-2.5-flash@google~long-context"
model_provider = "homelab-litellm"
model_reasoning_effort = "low"
model_context_window = 1000000
model_auto_compact_token_limit = 900000

[model_providers.homelab-litellm]
name = "Homelab LiteLLM"
base_url = "http://litellm.hom.lab/v1"
env_key = "LITELLM_API_KEY"
wire_api = "responses"
request_max_retries = 1
stream_max_retries = 1
stream_idle_timeout_ms = 120000
