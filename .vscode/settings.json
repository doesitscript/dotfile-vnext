{
  "python.useEnvironmentsExtension": false,
  "python.defaultInterpreterPath": "/Users/joshc/.ansible-venv/bin/python",
  "ansible.validation.enabled": false,
  // Ansible extension toolchain - project-level settings.
  //
  // Use the ~/.ansible-venv symlink because the Red Hat Ansible extension has
  // not reliably resolved ${workspaceFolder} in Python/Ansible path settings.
  "ansible.python.activationScript": "/Users/joshc/.ansible-venv/bin/activate",
  // "ansible.ansible.path": "${workspaceFolder}/.venv/bin/ansible",
  // "ansible.validation.lint.path": "${workspaceFolder}/.venv/bin/ansible-lint",
  "chatgpt.openOnStartup": false,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/artifacts/**": true,
    "**/docs/intake/**": true,
    "**/rendered/**": true,
    "**/private/**": true,
    "**/vault/**": true
  },
  "search.exclude": {
    "**/artifacts/**": true,
    "**/docs/intake/**": true,
    "**/rendered/**": true,
    "**/private/**": true,
    "**/vault/**": true
  }
}
