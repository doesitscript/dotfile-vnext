#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ "$#" -eq 0 ]; then
  echo "Usage: bin/codex-env <command> [args...]" >&2
  exit 2
fi

# Some parent runtimes inject C.UTF-8, but macOS may not have that locale
# available. Normalize early so child shells do not emit setlocale warnings.
if [ "$(uname -s)" = "Darwin" ]; then
  if [ "${LANG:-}" = "C.UTF-8" ]; then
    export LANG="en_US.UTF-8"
  fi
  if [ "${LC_CTYPE:-}" = "C.UTF-8" ]; then
    export LC_CTYPE="en_US.UTF-8"
  fi
  if [ "${LC_ALL:-}" = "C.UTF-8" ]; then
    export LC_ALL="en_US.UTF-8"
  fi
fi

cd "${REPO_ROOT}"

ensure_repo_venv() {
  if [ -x "${REPO_ROOT}/.venv/bin/python3" ]; then
    return 0
  fi

  local pybin
  pybin="$(command -v python3 || command -v python || true)"
  if [ -z "${pybin}" ]; then
    echo "codex-env: python3/python not found; cannot bootstrap .venv" >&2
    return 1
  fi

  local req_file=""
  if [ -f "${REPO_ROOT}/requirements.txt" ]; then
    req_file="${REPO_ROOT}/requirements.txt"
  elif [ -f "${REPO_ROOT}/scripts/requirements.txt" ]; then
    req_file="${REPO_ROOT}/scripts/requirements.txt"
  fi

  echo "codex-env: creating .venv (${pybin})" >&2
  "${pybin}" -m venv "${REPO_ROOT}/.venv"
  "${REPO_ROOT}/.venv/bin/python3" -m pip install --upgrade pip >/dev/null

  if [ -n "${req_file}" ]; then
    echo "codex-env: installing ${req_file}" >&2
    "${REPO_ROOT}/.venv/bin/python3" -m pip install -r "${req_file}" >/dev/null
  else
    echo "codex-env: no requirements file found; created empty .venv" >&2
  fi
}

command_name="$(basename "$1")"
case "${command_name}" in
  python|python3|pip|pip3|ansible|ansible-*)
    ensure_repo_venv
    ;;
esac

if [ -f "${REPO_ROOT}/.envrc" ]; then
  set +u
  # shellcheck source=/dev/null
  source "${REPO_ROOT}/.envrc"
  set -u
fi

if [ -f "${REPO_ROOT}/bin/load-netbox-controller-env.sh" ]; then
  set +u
  # shellcheck source=/dev/null
  source "${REPO_ROOT}/bin/load-netbox-controller-env.sh"
  set -u
fi

if [ -f "${REPO_ROOT}/.venv/bin/activate" ]; then
  set +u
  # shellcheck source=/dev/null
  source "${REPO_ROOT}/.venv/bin/activate"
  set -u
fi

case "${command_name}" in
  ansible|ansible-*)
    if [ "$(uname -s)" = "Darwin" ]; then
      if [ -z "${TMPDIR:-}" ]; then
        export TMPDIR="/private/tmp"
      fi

      if [ -z "${ANSIBLE_LOCAL_TEMP:-}" ]; then
        export ANSIBLE_LOCAL_TEMP="${TMPDIR%/}/ansible-local"
      fi

      mkdir -p "${TMPDIR}" "${ANSIBLE_LOCAL_TEMP}"

      case "${ANSIBLE_REMOTE_TEMP:-}" in
        /private/tmp/*|/var/folders/*)
          unset ANSIBLE_REMOTE_TEMP
          ;;
      esac
    fi
    ;;
esac

exec "$@"
