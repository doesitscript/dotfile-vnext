# Copy this file to .envrc and fill in secret values. Do NOT commit .envrc.
# Required for WinRM / Ansible on macOS when connecting to Windows hosts.
# Run `direnv allow` in this dir so these are exported automatically; otherwise source .envrc or export manually.
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=yes
export no_proxy=*
export APIKEY="your_APIKEY_here"
