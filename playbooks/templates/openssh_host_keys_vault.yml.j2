---
# OpenSSH server host keys for Windows (generated by bootstrap_openssh_host_keys; do not edit by hand).
# Deployed to C:\ProgramData\ssh by bootstrap_windows.yaml when run from the Mac.
vault_openssh_host_keys:
  ssh_host_ed25519_key: |
{{ host_key_ed25519_content | indent(4, first=true) }}
  ssh_host_ed25519_key.pub: "{{ host_key_ed25519_pub_content | trim }}"
  ssh_host_rsa_key: |
{{ host_key_rsa_content | indent(4, first=true) }}
  ssh_host_rsa_key.pub: "{{ host_key_rsa_pub_content | trim }}"
