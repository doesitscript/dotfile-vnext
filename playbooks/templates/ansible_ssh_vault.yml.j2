---
# Ansible SSH key pair (generated by bootstrap_local.yml; do not edit by hand).
# Mac loads this vault and installs vault_ansible_ssh_private_key to use as SSH identity.
vault_ansible_ssh_private_key: |
{{ ansible_ssh_private_key_content | indent(2, first=true) }}
vault_ansible_ssh_public_key: "{{ ansible_ssh_public_key_content | trim }}"
