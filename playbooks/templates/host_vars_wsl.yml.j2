# inventory/host_vars/{{ physical_node }}-wsl.yaml
# This file is GENERATED by the bootstrap process - do not hand-edit
# It will be created/updated by playbooks/bootstrap_local.yml

physical_node: "{{ physical_node }}"
surface_type: wsl

host_ip: "{{ host_ip }}"  # Discovered by bootstrap (same as Windows)
wsl_user: "{{ wsl_user }}"  # Discovered from ansible_user_id
wsl_ssh_port: {{ wsl_ssh_port }}

wsl_distro: "{{ distro_name.stdout | default('') }}"  # Discovered from wsl.exe -l -q

# Ansible connection settings
ansible_connection: ssh
ansible_host: "{{ host_ip }}"
ansible_user: "{{ wsl_user }}"
ansible_port: {{ wsl_ssh_port }}
ansible_python_interpreter: /usr/bin/python3
ansible_ssh_private_key_file: "~/.ssh/id_ed25519_ansible"  # Mac uses this key to connect (expanded by Ansible)
