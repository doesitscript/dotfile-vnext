# This file is managed by Ansible.
# Do not edit this file directly.

# Semaphore database (BoltDB — embedded, no external DB required)
SEMAPHORE_DB_DIALECT=bolt
SEMAPHORE_DB=/etc/semaphore/database.boltdb

# Semaphore working directory for playbook checkouts
SEMAPHORE_PLAYBOOK_PATH=/tmp/semaphore/

# Admin account
SEMAPHORE_ADMIN={{ vault_vars.vault_semaphore_admin_username }}
SEMAPHORE_ADMIN_NAME={{ vault_vars.vault_semaphore_admin_name }}
SEMAPHORE_ADMIN_EMAIL={{ vault_vars.vault_semaphore_admin_email }}
SEMAPHORE_ADMIN_PASSWORD={{ vault_vars.vault_semaphore_admin_password }}

# Encryption key for stored access keys (must be >= 32 chars)
SEMAPHORE_ACCESS_KEY_ENCRYPTION={{ vault_vars.vault_semaphore_access_key_encryption }}
