{% set desktop_model_catalog = {
  'qwen2.5-coder-14b@desktop': {
    'display_name': 'Homelab Qwen2.5 Coder 14B Desktop',
    'description': 'Explicit local desktop coding-chat model routed through LiteLLM. Experimental chat lane only; not approved for shell-tool execution.'
  },
  'ministral-3-8b@desktop': {
    'display_name': 'Homelab Ministral 3 8B Desktop',
    'description': 'Explicit local desktop coding model routed through LiteLLM. Experimental, but aligned with the repo tool-call acceptance surface.'
  }
} %}
{% set desktop_model = desktop_model_catalog.get(
  codex_homelab_profiles_model,
  {
    'display_name': codex_homelab_profiles_model,
    'description': 'Explicit local desktop coding model routed through LiteLLM.'
  }
) %}
{
  "models": [
    {
      "slug": "{{ codex_homelab_profiles_model }}",
      "display_name": "{{ desktop_model.display_name }}",
      "description": "{{ desktop_model.description }}",
      "default_reasoning_level": "low",
      "supported_reasoning_levels": [{"effort": "low", "description": "Bounded local coding chat"}],
      "shell_type": "unified_exec",
      "visibility": "list",
      "supported_in_api": true,
      "priority": 1,
      "additional_speed_tiers": [],
      "service_tiers": [],
      "availability_nux": null,
      "upgrade": null,
      "model_messages": {
        "instructions_template": "You are a local coding assistant. Use concise responses and only the tools supplied by Codex.",
        "instructions_variables": {},
        "approvals": null,
        "collaboration_modes": null,
        "auto_review": null,
        "permissions": null,
        "multi_agent": null,
        "token_budget": {
          "reminder_threshold_tokens": 6144,
          "reminder_message_template": "<context_window_reminder>Your current context window is nearly exhausted; only {n_remaining} tokens remain.</context_window_reminder>",
          "guidance_message": "Keep a concise checkpoint for work that spans context windows.",
          "auto_compact_fallback_prompt": "<context_window_reminder>The current context window is exhausted. Save a concise checkpoint before continuing.</context_window_reminder>",
          "auto_compact_fallback_buffer_tokens": 16384
        }
      },
      "include_skills_usage_instructions": false,
      "include_plugin_usage_instructions": false,
      "include_apps_usage_instructions": false,
      "default_reasoning_summary": "none",
      "support_verbosity": true,
      "default_verbosity": "low",
      "apply_patch_tool_type": "freeform",
      "web_search_tool_type": "text_and_image",
      "truncation_policy": {"mode": "tokens", "limit": 10000},
      "supports_image_detail_original": true,
      "context_window": {{ codex_homelab_profiles_context_window }},
      "max_context_window": {{ codex_homelab_profiles_context_window }},
      "comp_hash": "3000",
      "effective_context_window_percent": 90,
      "experimental_supported_tools": [],
      "input_modalities": ["text"],
      "supports_search_tool": false,
      "use_responses_lite": true,
      "node_repl_auto_review_required": false,
      "node_repl_disabled": false,
      "tool_mode": "code_mode_only",
      "multi_agent_version": "v2",
      "base_instructions": "You are a local coding assistant. Use concise responses and only the tools supplied by Codex.",
      "supports_reasoning_summaries": false,
      "supports_parallel_tool_calls": false
    }
  ]
}
