# {{ ansible_managed }}
# AI Request Inspector — observe-only LiteLLM callback for this homelab gateway.
#
# Emits a structured per-request budget report (model, context slices, largest
# tools, warnings, finish_reason). Does NOT trim or rewrite messages.
#
# Former mutate path (trim_messages + hard-cut) is archived at:
#   roles/k3s_litellm_gateway/archive/trim-messages-callback-2026-07/
from __future__ import annotations

import json
import os
import time
from typing import Any, Literal, Optional

from litellm.integrations.custom_logger import CustomLogger
from litellm.utils import token_counter

_TOKENIZER_MODEL = "hosted_vllm/{{ k3s_litellm_gateway_primary_vllm_model }}"
_HARD_CONTEXT = {{ k3s_litellm_gateway_request_inspector_max_window | int }}
_SAFETY_TOKENS = {{ k3s_litellm_gateway_request_inspector_safety_tokens | int }}
_CHARS_PER_TOKEN = {{ k3s_litellm_gateway_request_inspector_chars_per_token | float }}
_WARN_TOOLS_PCT = {{ k3s_litellm_gateway_request_inspector_warn_tools_pct | float }}
_WARN_CONVERSATION_PCT = {{ k3s_litellm_gateway_request_inspector_warn_conversation_pct | float }}
_DUMP_ON_WARN = {{ k3s_litellm_gateway_request_inspector_dump_tools_on_warn | bool }}
_CONFIG_PATH = "/etc/litellm/config.yaml"

# request_id -> pre-call report (merged on success/failure with finish_reason)
_PENDING: dict[str, dict[str, Any]] = {}


def _chars_to_tokens(raw: str) -> int:
    return max(0, int(len(raw) / _CHARS_PER_TOKEN))


def _tool_entry_name(tool: Any) -> str:
    if not isinstance(tool, dict):
        return "unknown"
    fn = tool.get("function")
    if isinstance(fn, dict) and isinstance(fn.get("name"), str) and fn["name"]:
        return fn["name"]
    name = tool.get("name")
    if isinstance(name, str) and name:
        return name
    return "unknown"


def _analyze_tools(data: dict) -> dict[str, Any]:
    tools = data.get("tools")
    empty = {
        "tool_count_total": 0,
        "tool_tokens_total": 0,
        "per_tool": [],
        "tools_raw": tools if tools else [],
    }
    if not tools:
        return empty
    if not isinstance(tools, list):
        try:
            raw = json.dumps(tools, ensure_ascii=False)
        except (TypeError, ValueError):
            raw = str(tools)
        total = _chars_to_tokens(raw)
        return {
            "tool_count_total": 1,
            "tool_tokens_total": total,
            "per_tool": [{"name": "tools_blob", "tokens": total}],
            "tools_raw": tools,
        }

    per_tool: list[dict[str, Any]] = []
    total = 0
    for tool in tools:
        name = _tool_entry_name(tool)
        try:
            raw = json.dumps(tool, ensure_ascii=False)
        except (TypeError, ValueError):
            raw = str(tool)
        tokens = _chars_to_tokens(raw)
        total += tokens
        per_tool.append({"name": name, "tokens": tokens, "raw": tool})
    per_tool.sort(key=lambda row: (-int(row["tokens"]), str(row["name"])))
    return {
        "tool_count_total": len(per_tool),
        "tool_tokens_total": total,
        "per_tool": per_tool,
        "tools_raw": tools,
    }


def _flatten_content(content: Any) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts: list[str] = []
        for item in content:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                text = item.get("text")
                if isinstance(text, str):
                    parts.append(text)
                else:
                    parts.append(json.dumps(item, ensure_ascii=False))
            else:
                parts.append(str(item))
        return "\n".join(parts)
    if isinstance(content, dict):
        text = content.get("text")
        if isinstance(text, str):
            return text
        return json.dumps(content, ensure_ascii=False)
    return str(content)


def _message_role_tokens(messages: list) -> dict[str, int]:
    system = 0
    conversation = 0
    for msg in messages:
        if not isinstance(msg, dict):
            continue
        flat = _flatten_content(msg.get("content"))
        tokens = _chars_to_tokens(flat)
        role = str(msg.get("role") or "").lower()
        if role == "system":
            system += tokens
        else:
            conversation += tokens
    return {"system": system, "conversation": conversation}


def _resolve_backend(alias: str) -> str:
    """Best-effort backend id from mounted config model_list."""
    try:
        import yaml

        with open(_CONFIG_PATH, encoding="utf-8") as handle:
            cfg = yaml.safe_load(handle) or {}
        for row in cfg.get("model_list") or []:
            if not isinstance(row, dict):
                continue
            if str(row.get("model_name") or "") != alias:
                continue
            params = row.get("litellm_params") or {}
            if isinstance(params, dict) and params.get("model"):
                return str(params["model"])
    except Exception:  # noqa: BLE001
        pass
    return ""


def _request_key(data: dict) -> str:
    for key in ("litellm_call_id", "id"):
        val = data.get(key)
        if val:
            return str(val)
    return f"anon-{int(time.time() * 1000)}-{id(data)}"


def _build_report(data: dict, call_type: str) -> dict[str, Any]:
    alias = str(data.get("model") or "")
    messages = data.get("messages") if isinstance(data.get("messages"), list) else []
    tools = _analyze_tools(data)
    roles = _message_role_tokens(messages)

    try:
        conversation_tc = token_counter(model=_TOKENIZER_MODEL, messages=messages) if messages else 0
    except Exception:  # noqa: BLE001
        conversation_tc = roles["system"] + roles["conversation"]

    try:
        requested_out = int(data.get("max_tokens") or 0)
    except (TypeError, ValueError):
        requested_out = 0

    tools_tokens = int(tools.get("tool_tokens_total") or 0)
    system_tokens = int(roles["system"])
    # Prefer tokenizer total for conversation budget view; fall back to char est.
    conv_tokens = max(0, int(conversation_tc) - system_tokens) if conversation_tc else int(roles["conversation"])

    reserved_output = requested_out if requested_out > 0 else 0
    largest = [
        {row["name"]: int(row["tokens"])}
        for row in (tools.get("per_tool") or [])[:8]
    ]

    estimated_input = tools_tokens + system_tokens + conv_tokens
    warnings: list[str] = []
    if _HARD_CONTEXT > 0 and tools_tokens > (_HARD_CONTEXT * _WARN_TOOLS_PCT):
        warnings.append(
            f"tool budget exceeds {int(_WARN_TOOLS_PCT * 100)}% of context "
            f"({tools_tokens}/{_HARD_CONTEXT})"
        )
    if _HARD_CONTEXT > 0 and conv_tokens < (_HARD_CONTEXT * _WARN_CONVERSATION_PCT):
        if tools_tokens > (_HARD_CONTEXT * 0.5):
            warnings.append(
                f"conversation share below {int(_WARN_CONVERSATION_PCT * 100)}% "
                f"of context ({conv_tokens}/{_HARD_CONTEXT})"
            )
    if estimated_input + reserved_output + _SAFETY_TOKENS > _HARD_CONTEXT:
        warnings.append(
            "estimated input + reserved_output + safety exceeds max_window "
            f"({estimated_input}+{reserved_output}+{_SAFETY_TOKENS}>{_HARD_CONTEXT})"
        )

    report = {
        "model": {
            "alias": alias,
            "backend": _resolve_backend(alias) or _TOKENIZER_MODEL,
        },
        "context": {
            "max_window": _HARD_CONTEXT,
            "tools": tools_tokens,
            "system": system_tokens,
            "conversation": conv_tokens,
            "reserved_output": reserved_output,
            "safety": _SAFETY_TOKENS,
            "estimated_input": estimated_input,
        },
        "largest_tools": largest,
        "trim": {
            "enabled": False,
            "before": estimated_input,
            "after": estimated_input,
            "note": "mutate path archived; observe-only inspector",
        },
        "finish_reason": None,
        "warnings": warnings,
        "meta": {
            "call_type": call_type,
            "tool_count_total": int(tools.get("tool_count_total") or 0),
            "tokenizer_model": _TOKENIZER_MODEL,
        },
    }
    return report


def _emit(report: dict[str, Any]) -> None:
    line = "litellm request_inspector " + json.dumps(report, ensure_ascii=False, separators=(",", ":"))
    print(line, flush=True)


def _maybe_dump_tools(report: dict[str, Any], tools_analysis: dict[str, Any]) -> None:
    if not _DUMP_ON_WARN:
        return
    if not report.get("warnings"):
        return
    base = os.environ.get(
        "LITELLM_REQUEST_INSPECTOR_DUMP_DIR",
        "/tmp/litellm-request-inspector",
    )
    try:
        os.makedirs(base, exist_ok=True)
        stamp = int(time.time())
        alias = (report.get("model") or {}).get("alias") or "unknown"
        safe = "".join(c if c.isalnum() or c in "-_." else "_" for c in str(alias))[:80]
        path = os.path.join(base, f"{stamp}-{safe}-summary.json")
        payload = {
            "report": report,
            "tool_count_total": tools_analysis.get("tool_count_total"),
            "top_tools": [
                {"name": r["name"], "tokens": r["tokens"]}
                for r in (tools_analysis.get("per_tool") or [])[:10]
            ],
        }
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, indent=2)
        print(f"litellm request_inspector dump_path={path}", flush=True)
    except Exception as exc:  # noqa: BLE001
        print(f"litellm request_inspector dump_failed: {exc}", flush=True)


def _finish_reason_from_response(response_obj: Any) -> Optional[str]:
    try:
        choices = getattr(response_obj, "choices", None)
        if choices is None and isinstance(response_obj, dict):
            choices = response_obj.get("choices")
        if not choices:
            return None
        first = choices[0]
        if isinstance(first, dict):
            return first.get("finish_reason")
        return getattr(first, "finish_reason", None)
    except Exception:  # noqa: BLE001
        return None


class RequestInspectorHandler(CustomLogger):
    """Observe-only: structured context budget reports for every proxy call."""

    async def async_pre_call_hook(
        self,
        user_api_key_dict: Any,
        cache: Any,
        data: dict,
        call_type: Literal[
            "completion",
            "text_completion",
            "embeddings",
            "image_generation",
            "moderation",
            "audio_transcription",
        ],
    ) -> Optional[dict]:
        try:
            tools_analysis = _analyze_tools(data)
            report = _build_report(data, str(call_type))
            key = _request_key(data)
            _PENDING[key] = report
            # Keep pending map bounded
            if len(_PENDING) > 256:
                for stale in list(_PENDING.keys())[:64]:
                    _PENDING.pop(stale, None)
            _emit(report)
            _maybe_dump_tools(report, tools_analysis)
        except Exception as exc:  # noqa: BLE001 - never block the request
            print(f"litellm request_inspector pre_call failed: {exc}", flush=True)
        return data

    async def async_log_success_event(
        self, kwargs: dict, response_obj: Any, start_time: Any, end_time: Any
    ) -> None:
        try:
            data = kwargs.get("litellm_params") or {}
            if not isinstance(data, dict):
                data = {}
            # Prefer call id from kwargs
            key = str(
                kwargs.get("litellm_call_id")
                or data.get("litellm_call_id")
                or ""
            )
            report = _PENDING.pop(key, None) if key else None
            if report is None:
                # Still emit a minimal post-call line
                alias = str(kwargs.get("model") or "")
                report = {
                    "model": {"alias": alias, "backend": _resolve_backend(alias)},
                    "finish_reason": _finish_reason_from_response(response_obj),
                    "warnings": [],
                    "meta": {"phase": "success_only"},
                }
            else:
                report = dict(report)
                report["finish_reason"] = _finish_reason_from_response(response_obj)
                if report.get("finish_reason") == "length":
                    warnings = list(report.get("warnings") or [])
                    warnings.append("finish_reason=length")
                    report["warnings"] = warnings
            _emit(report)
        except Exception as exc:  # noqa: BLE001
            print(f"litellm request_inspector success_event failed: {exc}", flush=True)

    async def async_log_failure_event(
        self, kwargs: dict, response_obj: Any, start_time: Any, end_time: Any
    ) -> None:
        try:
            data = kwargs.get("litellm_params") or {}
            if not isinstance(data, dict):
                data = {}
            key = str(
                kwargs.get("litellm_call_id")
                or data.get("litellm_call_id")
                or ""
            )
            report = _PENDING.pop(key, None) if key else None
            if report is None:
                report = {
                    "model": {
                        "alias": str(kwargs.get("model") or ""),
                        "backend": "",
                    },
                    "finish_reason": "error",
                    "warnings": ["proxy_call_failed"],
                    "meta": {"phase": "failure_only"},
                }
            else:
                report = dict(report)
                report["finish_reason"] = "error"
                warnings = list(report.get("warnings") or [])
                warnings.append("proxy_call_failed")
                report["warnings"] = warnings
            _emit(report)
        except Exception as exc:  # noqa: BLE001
            print(f"litellm request_inspector failure_event failed: {exc}", flush=True)


proxy_handler_instance = RequestInspectorHandler()
