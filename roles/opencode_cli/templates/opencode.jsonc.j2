{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ opencode_cli_default_model }}",
  "provider": {
    "{{ opencode_cli_provider_id }}": {
      "npm": "{{ opencode_cli_provider_npm }}",
      "name": "{{ opencode_cli_provider_display_name }}",
      "options": {
        "baseURL": "{{ opencode_cli_gateway_api_base }}",
        "apiKey": "{env:{{ opencode_cli_api_key_env }}}"
      },
      "models": {
{% for m in opencode_cli_models %}
        "{{ m.id }}": {
          "name": {{ m.name | to_json }},
          "limit": {
            "context": {{ opencode_cli_context_limit }},
            "output": {{ opencode_cli_output_limit }}
          }
        }{% if not loop.last %},{% endif %}

{% endfor %}
      }
    }
  }{% if opencode_cli_mcp_context7_enabled or opencode_cli_mcp_firecrawl_enabled %},
  "mcp": {
{% if opencode_cli_mcp_context7_enabled %}
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }{% if opencode_cli_mcp_firecrawl_enabled %},{% endif %}

{% endif %}
{% if opencode_cli_mcp_firecrawl_enabled %}
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@latest"],
      "environment": {
        "FIRECRAWL_API_KEY": "{{ opencode_cli_render_firecrawl_api_key | default('REPLACE_WITH_FIRECRAWL_KEY') }}"
      }
    }
{% endif %}
  }
{% endif %}
}
