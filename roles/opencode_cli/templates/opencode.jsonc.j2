{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ opencode_cli_default_model }}",
  "provider": {
    "{{ opencode_cli_provider_id }}": {
      "npm": "{{ opencode_cli_provider_npm }}",
      "name": "{{ opencode_cli_provider_display_name }}",
      "options": {
        "baseURL": "{{ opencode_cli_gateway_api_base }}",
        "apiKey": "{env:{{ opencode_cli_api_key_env }}}"
      },
      "models": {
{% for m in opencode_cli_models if m.enabled | default(true) %}
        "{{ m.id }}": {
          "name": {{ m.name | to_json }},
          "limit": {
            "context": {{ m.context | default(opencode_cli_context_limit) }},
            "output": {{ m.output | default(opencode_cli_output_limit) }}
          }
        }{% if not loop.last %},{% endif %}

{% endfor %}
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": {{ opencode_cli_mcp_context7_enabled | bool | lower }},
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"]
    },
    "firecrawl": {
      "type": "local",
      "enabled": {{ opencode_cli_mcp_firecrawl_enabled | bool | lower }},
      "command": ["npx", "-y", "firecrawl-mcp@latest"],
      "environment": {
        "FIRECRAWL_API_KEY": "{{ opencode_cli_render_firecrawl_api_key | default('REPLACE_WITH_FIRECRAWL_KEY') }}"
      }
    }
  }
}
