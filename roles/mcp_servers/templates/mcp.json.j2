{
  "mcpServers": {
{% for server in mcp_aws_servers %}
    "{{ server.name }}": {
      "command": "{{ mcp_docker_bin }}",
      "args": [
        "run", "--rm", "-i",
        "--env-file", "{{ mcp_aws_credentials_env_file }}",
        "{{ mcp_aws_image }}",
        "python", "-m", "{{ server.module }}"
      ],
      "env": {}
    },
{% endfor %}
    "sysoperator": {
      "command": "{{ mcp_docker_bin }}",
      "args": [
        "run", "--rm", "-i",
        "{{ mcp_sysoperator_image }}",
        "node", "/opt/mcp-sysoperator/build/index.js"
      ],
      "env": {}
    }
  }
}
