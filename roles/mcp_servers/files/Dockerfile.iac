FROM node:20-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG SYSOPERATOR_VERSION=main
RUN git clone --depth 1 --branch ${SYSOPERATOR_VERSION} \
    https://github.com/tarnover/mcp-sysoperator.git

WORKDIR /app/mcp-sysoperator
RUN npm install && npm run build

# --- runtime stage ---
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    curl unzip gnupg software-properties-common \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
    ansible-core awscli

# HashiCorp APT repo for Terraform
RUN curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(. /etc/os-release && echo $VERSION_CODENAME) main" \
        > /etc/apt/sources.list.d/hashicorp.list \
    && apt-get update && apt-get install -y --no-install-recommends terraform \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/mcp-sysoperator
COPY --from=builder /app/mcp-sysoperator/build ./build
COPY --from=builder /app/mcp-sysoperator/node_modules ./node_modules
COPY --from=builder /app/mcp-sysoperator/package.json ./package.json

ENTRYPOINT ["node", "/app/mcp-sysoperator/build/index.js"]
