FROM python:3.12-slim

LABEL maintainer="joshc" \
      description="AWS MCP servers (core, CDK, CloudControl) for IDE integration"

RUN pip install --no-cache-dir \
    awslabs.core_mcp_server \
    awslabs.cdk_mcp_server \
    awslabs.ccapi_mcp_server

ENTRYPOINT ["python", "-m"]
CMD ["awslabs.core_mcp_server"]
