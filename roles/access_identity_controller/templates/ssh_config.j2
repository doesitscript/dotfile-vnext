# ~/.ssh/config — managed by Ansible (access_identity_controller)
# Generated from inventory group: ssh_targets
# Windows hosts render from OpenSSH desired state.
# WSL surfaces render from active wsl_hosts membership.
# Linux VMs render when they have realized connection facts.
# Manual edits below the ANSIBLE MANAGED block will be preserved.

{% for host in groups['ssh_targets'] | default([]) | sort %}
{% set hv = hostvars[host] %}
{% set openssh_state = hv.get('openssh_server_state', '') %}
{% set windows_ssh_state = openssh_state if openssh_state else ('present' if hv.get('openssh_server_enabled', true) else 'absent') %}
{% set ipv6_host = hv.get('host_ipv6', '') %}
{% set emit_ssh_entry = (
  (hv.get('surface_type', '') == 'windows_host' and windows_ssh_state == 'present')
  or (hv.get('surface_type', '') == 'wsl' and host in (groups['wsl_hosts'] | default([])))
  or (hv.get('surface_type', '') == 'ubuntu_vm' and hv.get('ansible_host', ''))
) %}
{% if emit_ssh_entry %}
{% if hv.ssh_powershell_port is defined %}
# NOTE: SSH to Windows hosts lands in WSL bash (DefaultShell = wsl.exe), but
# this is NOT true SSH into the WSL distribution. Windows sshd accepts the
# connection and forwards to WSL. Auth, keys, and sshd_config are Windows-side.
{% elif hv.get('surface_type', '') == 'wsl' %}
# WSL direct SSH — connects to the distro's own sshd (bridged LAN IP or NAT portproxy).
{% endif %}
Host {{ host }}
    HostName {{ hv.get('ansible_host', host) }}
    User {{ hv.get('ssh_user', hv.get('win_ssh_user', hv.get('wsl_user', hv.get('ansible_user', 'joshc')))) }}
    Port {{ hv.get('ssh_port', hv.get('win_ssh_port', hv.get('wsl_ssh_port', hv.get('ansible_port', 22)))) }}
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% if ipv6_host %}

Host {{ host }}-ipv6
    HostName {{ ipv6_host }}
    User {{ hv.get('ssh_user', hv.get('win_ssh_user', hv.get('wsl_user', hv.get('ansible_user', 'joshc')))) }}
    Port {{ hv.get('ssh_port', hv.get('win_ssh_port', hv.get('wsl_ssh_port', hv.get('ansible_port', 22)))) }}
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% endif %}
{% if hv.ssh_powershell_port is defined %}

# Direct PowerShell session for connecting to windows host, uses port win_ssh_powershell_port
# Troubleshooting: if port {{ hv['ssh_powershell_port'] }} is down, use the WSL fallback:
#   ssh {{ host }} -t /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
Host {{ host }}-powershell
    HostName {{ hv.get('ansible_host', host) }}
    User {{ hv.get('ssh_user', hv.get('win_ssh_user', hv.get('wsl_user', hv.get('ansible_user', 'joshc')))) }}
    # Port {{ hv['ssh_powershell_port'] }}
    ControlMaster no
    ControlPath none
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

# PowerShell session via subsystem — no explicit port, no proxy
Host {{ host }}-powershell-bysession
    HostName {{ hv.get('ansible_host', host) }}
    User {{ hv.get('ssh_user', hv.get('win_ssh_user', hv.get('wsl_user', hv.get('ansible_user', 'joshc')))) }}
    ControlMaster no
    ControlPath none
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% if ipv6_host %}

Host {{ host }}-powershell-ipv6
    HostName {{ ipv6_host }}
    User {{ hv.get('ssh_user', hv.get('win_ssh_user', hv.get('wsl_user', hv.get('ansible_user', 'joshc')))) }}
    ControlMaster no
    ControlPath none
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% endif %}
{% endif %}

{% endif %}
{% endfor %}
# --- ControlMaster multiplexing (Linux/WSL controller only; omitted on Windows/Darwin) ---
{% if ansible_facts['system'] is defined and ansible_facts['system'] == 'Linux' %}
Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%n-%C
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 5
    SetEnv LC_ALL=C.UTF-8
{% endif %}
