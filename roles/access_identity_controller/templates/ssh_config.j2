# ~/.ssh/config — managed by Ansible (access_identity_controller)
# Generated from inventory group: ssh_targets
# Windows hosts render from OpenSSH desired state.
# Ubuntu guest surfaces render from linux_vm_hosts once they have realized
# connection facts such as ansible_host.
# Manual edits below the ANSIBLE MANAGED block will be preserved.

{% for host in groups['ssh_targets'] | default([]) | sort %}
{% set hv = hostvars[host] %}
{% set openssh_state = hv.get('openssh_server_state', '') %}
{% set windows_ssh_state = openssh_state if openssh_state else ('present' if hv.get('openssh_server_enabled', true) else 'absent') %}
{% set ipv6_host = hv.get('host_ipv6', '') %}
{% set ssh_user = hv.get('ssh_user') or hv.get('win_ssh_user') or hv.get('ansible_user') or 'joshc' %}
{% set ssh_port = hv.get('ssh_port') or hv.get('win_ssh_port') or hv.get('ansible_port') or 22 %}
{% set emit_ssh_entry = (
  (hv.get('surface_type', '') == 'windows_host' and windows_ssh_state == 'present')
  or (hv.get('surface_type', '') == 'ubuntu_vm' and hv.get('ansible_host', ''))
) %}
{% if emit_ssh_entry %}
{% if hv.ssh_powershell_port is defined %}
# Windows host direct SSH surface.
{% elif hv.get('surface_type', '') == 'ubuntu_vm' %}
# Ubuntu guest direct SSH — Hyper-V guest surface on the routed/private guest network.
{% endif %}
Host {{ host }}
    HostName {{ hv.get('ansible_host', host) }}
    User {{ ssh_user }}
    Port {{ ssh_port }}
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% if ipv6_host %}

Host {{ host }}-ipv6
    HostName {{ ipv6_host }}
    User {{ ssh_user }}
    Port {{ ssh_port }}
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% endif %}
{% if hv.ssh_powershell_port is defined %}

# Direct PowerShell session for connecting to the Windows host.
Host {{ host }}-powershell
    HostName {{ hv.get('ansible_host', host) }}
    User {{ ssh_user }}
    # Port {{ hv['ssh_powershell_port'] }}
    ControlMaster no
    ControlPath none
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

# PowerShell session via subsystem — no explicit port, no proxy
Host {{ host }}-powershell-bysession
    HostName {{ hv.get('ansible_host', host) }}
    User {{ ssh_user }}
    ControlMaster no
    ControlPath none
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% if ipv6_host %}

Host {{ host }}-powershell-ipv6
    HostName {{ ipv6_host }}
    User {{ ssh_user }}
    ControlMaster no
    ControlPath none
    IdentityFile {{ controller_ssh_private_key_path }}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
{% endif %}
{% endif %}

{% endif %}
{% endfor %}
# --- ControlMaster multiplexing (Linux controller only; omitted on Windows/Darwin) ---
{% if ansible_facts['system'] is defined and ansible_facts['system'] == 'Linux' %}
Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%n-%C
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 5
    SetEnv LC_ALL=C.UTF-8
{% endif %}
