# {{ ansible_managed }}
# Continue → LiteLLM only for remote lanes. Continue probes GET {apiBase};
# use http://litellm.hom.lab without a trailing /v1 (bare /v1 404s on this gateway).
# Full-file desired state: every continue_ide_models / local entry with
# enabled|default(true) is rendered. No role-specific omit gates in this
# template — disable an entry with enabled: false (or omit it from the list).
# Blocked / not commissioned:
{% for lane in continue_ide_blocked_lanes %}
#   - {{ lane }}
{% endfor %}
name: {{ continue_ide_config_name | to_json }}
version: {{ continue_ide_config_version | to_json }}
schema: {{ continue_ide_config_schema | to_json }}
models:
{% for entry in continue_ide_models if entry.enabled | default(true) %}
  - name: {{ entry.name | to_json }}
    provider: {{ (entry.provider | default(continue_ide_provider)) | to_json }}
    apiBase: {{ (entry.api_base | default(continue_ide_gateway_api_base)) | to_json }}
    model: {{ entry.model | to_json }}
    apiKey: {{ continue_ide_render_api_key | to_json }}
{% if entry.capabilities is defined %}
    capabilities:
{% for capability in entry.capabilities %}
      - {{ capability | to_json }}
{% endfor %}
{% endif %}
{% if (entry.roles | default([])) | length > 0 %}
    roles:
{% for role in entry.roles %}
      - {{ role | to_json }}
{% endfor %}
{% else %}
    roles: []
{% endif %}
{% if entry.default_completion_options is defined %}
    defaultCompletionOptions:
{% for opt_key, opt_val in entry.default_completion_options.items() %}
      {{ opt_key }}: {{ opt_val }}
{% endfor %}
{% endif %}
{% if entry.autocomplete_options is defined %}
    autocompleteOptions:
{% for opt_key, opt_val in entry.autocomplete_options.items() %}
      {{ opt_key }}: {{ opt_val }}
{% endfor %}
{% endif %}
{% if entry.use_legacy_completions_endpoint | default(false) %}
    useLegacyCompletionsEndpoint: true
    promptTemplates:
      autocomplete: {% raw %}"<|fim_prefix|>{{{prefix}}}<|fim_suffix|>{{{suffix}}}<|fim_middle|>"{% endraw %}

{% endif %}
{% if entry.prompt_templates is defined %}
    promptTemplates:
{% for tmpl_key, tmpl_val in entry.prompt_templates.items() %}
      {{ tmpl_key }}: {{ tmpl_val | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{% set _continue_local_models = (continue_ide_local_models | default(continue_ide_ollama_local_models | default([]))) %}
{% if (_continue_local_models | length) > 0 %}
  # BEGIN ANSIBLE MANAGED: continue-local-models
  # Client-local OpenAI-compatible (or legacy ollama) models only.
{% for entry in _continue_local_models if entry.enabled | default(true) %}
  - name: {{ entry.name | to_json }}
    provider: {{ (entry.provider | default('openai')) | to_json }}
    apiBase: {{ (entry.api_base | default('http://127.0.0.1:1337/v1')) | to_json }}
    model: {{ entry.model | to_json }}
{% if (entry.provider | default('openai')) != 'ollama' %}
    apiKey: {{ (entry.api_key | default('local')) | to_json }}
{% endif %}
{% if (entry.roles | default([])) | length > 0 %}
    roles:
{% for role in entry.roles %}
      - {{ role | to_json }}
{% endfor %}
{% else %}
    roles: []
{% endif %}
{% if entry.default_completion_options is defined %}
    defaultCompletionOptions:
{% for opt_key, opt_val in entry.default_completion_options.items() %}
      {{ opt_key }}: {{ opt_val }}
{% endfor %}
{% endif %}
{% if entry.autocomplete_options is defined %}
    autocompleteOptions:
{% for opt_key, opt_val in entry.autocomplete_options.items() %}
      {{ opt_key }}: {{ opt_val }}
{% endfor %}
{% endif %}
{% if entry.use_legacy_completions_endpoint | default(false) %}
    useLegacyCompletionsEndpoint: true
{% endif %}
{% if entry.prompt_templates is defined %}
    promptTemplates:
{% for tmpl_key, tmpl_val in entry.prompt_templates.items() %}
      {{ tmpl_key }}: {{ tmpl_val | to_json }}
{% endfor %}
{% elif entry.use_legacy_completions_endpoint | default(false) %}
    promptTemplates:
      autocomplete: {% raw %}"<|fim_prefix|>{{{prefix}}}<|fim_suffix|>{{{suffix}}}<|fim_middle|>"{% endraw %}

{% endif %}
{% endfor %}
  # END ANSIBLE MANAGED: continue-local-models
{% endif %}
{% if (continue_ide_mcp_servers | default([]) | length) > 0 %}
mcpServers:
{% for server in continue_ide_mcp_servers %}
  - name: {{ server.name | to_json }}
{% if server.type is defined %}
    type: {{ server.type | to_json }}
{% endif %}
{% if server.command is defined %}
    command: {{ server.command | to_json }}
{% endif %}
{% if server.args is defined %}
    args:
{% for arg in server.args %}
      - {{ arg | to_json }}
{% endfor %}
{% endif %}
{% if server.url is defined %}
    url: {{ server.url | to_json }}
{% endif %}
{% if server.cwd is defined %}
    cwd: {{ server.cwd | to_json }}
{% endif %}
{% if server.env is defined %}
    env:
{% for env_key, env_val in server.env.items() %}
      {{ env_key }}: {{ env_val | to_json }}
{% endfor %}
{% endif %}
{% if server.api_key is defined %}
    apiKey: {{ server.api_key | to_json }}
{% endif %}
{% if server.connection_timeout is defined %}
    connectionTimeout: {{ server.connection_timeout }}
{% endif %}
{% if server.request_options is defined %}
    requestOptions:
{% for req_key, req_val in server.request_options.items() %}
      {{ req_key }}: {{ req_val | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% if (continue_ide_rules | default([]) | length) > 0 %}
rules:
{% for rule in continue_ide_rules %}
  - uses: {{ rule.uses | to_json }}
{% endfor %}
{% endif %}
