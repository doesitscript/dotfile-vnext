#!/usr/bin/env bash
set -euo pipefail

warning_percent={{ storage_capacity_monitor_warning_percent | int }}
critical_percent={{ storage_capacity_monitor_critical_percent | int }}

emit_event() {
  local priority="$1"
  shift
  printf '%s\n' "$*" | systemd-cat --identifier=storage-capacity-monitor --priority="$priority"
}

{% for mount in storage_capacity_monitor_mounts %}
path={{ mount.path | quote }}
required={{ (mount.required | default(true) | bool) | ternary('true', 'false') }}
if ! findmnt --mountpoint "$path" >/dev/null 2>&1; then
  if [[ "$required" == "true" ]]; then
    emit_event err "status=unavailable path=$path required=true"
  else
    emit_event warning "status=unavailable path=$path required=false"
  fi
else
  used_percent="$(df -P --output=pcent "$path" | tail -n 1 | tr -dc '0-9')"
  if (( used_percent >= critical_percent )); then
    status=critical
    priority=err
  elif (( used_percent >= warning_percent )); then
    status=warning
    priority=warning
  else
    status=ok
    priority=info
  fi
  emit_event "$priority" "status=$status path=$path used_percent=$used_percent warning_percent=$warning_percent critical_percent=$critical_percent"
fi
{% endfor %}
