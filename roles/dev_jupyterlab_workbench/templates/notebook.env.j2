# Managed by Ansible for the JupyterLab workbench on {{ inventory_hostname }}
# This is the real runtime environment consumed by notebook code on the host.
LANGFUSE_HOST={{ dev_jupyterlab_workbench_langfuse_host }}
LANGFUSE_PUBLIC_KEY={{ dev_jupyterlab_workbench_langfuse_public_key }}
LANGFUSE_SECRET_KEY={{ dev_jupyterlab_workbench_langfuse_secret_key }}

# Point OpenAI-compatible clients at the local LiteLLM gateway.
OPENAI_BASE_URL={{ dev_jupyterlab_workbench_openai_base_url }}
OPENAI_API_KEY={{ dev_jupyterlab_workbench_openai_api_key }}
OPENAI_MODEL={{ dev_jupyterlab_workbench_openai_model }}

# Set when a recipe uses Anthropic directly rather than LiteLLM.
ANTHROPIC_API_KEY={{ dev_jupyterlab_workbench_anthropic_api_key }}
