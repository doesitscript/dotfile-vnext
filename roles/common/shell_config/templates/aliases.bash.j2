# Common shell aliases
# Managed by Ansible role: common/shell_config

# Directory listing aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ls='ls --color=auto'  # Colorized ls (GNU coreutils)
alias lh='ls -lh'  # Human-readable sizes

# Navigation aliases
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Safety aliases (prevent accidental deletions)
alias rm='rm -i'  # Interactive remove
alias cp='cp -i'  # Interactive copy
alias mv='mv -i'  # Interactive move

# Quick edits
alias e='${EDITOR:-nano}'
alias v='${EDITOR:-vim}'

# Common shortcuts
alias h='history'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# System info
alias df='df -h'  # Human-readable disk usage
alias du='du -h'  # Human-readable directory sizes
alias free='free -h'  # Human-readable memory (Linux)

# Git shortcuts (basic - git role may add more)
alias g='git'
alias gs='git status'
