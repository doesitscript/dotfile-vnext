\
tarsnap(){\
	docker run --rm -it \\
		-v "${HOME}/.tarsnaprc:/root/.tarsnaprc" \\
		-v "${HOME}/.tarsnap:/root/.tarsnap" \\
		-v "$HOME:/root/workdir" \\
		${DOCKER_REPO_PREFIX}/tarsnap "$@"\
}\
\
#telnet(){\
#	docker run -it --rm \\
#		--log-driver none \\
#		${DOCKER_REPO_PREFIX}/telnet "$@"\
#}\
\
termboy(){\
	del_stopped termboy\
	local game=$1\
\
	docker run --rm -it \\
		--device /dev/snd \\
		--name termboy \\
		${DOCKER_REPO_PREFIX}/nes "/games/${game}.rom"\
}\
\
