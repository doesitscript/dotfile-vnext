\
tor(){\
	del_stopped tor\
\
	docker run -d \\
		--net host \\
		--name tor \\
		${DOCKER_REPO_PREFIX}/tor\
\
	# set up the redirect iptables rules\
	sudo setup-tor-iptables\
\
	# validate we are running through tor\
	browser-exec "https://check.torproject.org/"\
}\

