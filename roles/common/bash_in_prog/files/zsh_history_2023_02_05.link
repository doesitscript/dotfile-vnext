: 1647451186:0;pandoc(){\
	local file=${*: -1}\
	local lfile\
	lfile=$(readlink -m "$(pwd)/${file}")\
	local rfile\
	rfile=$(readlink -m "/$(basename "$file")")\
	local args=${*:1:${#@}-1}\
\
	docker run --rm \\
		-v "${lfile}:${rfile}" \\
		-v /tmp:/tmp \\
		--name pandoc \\
		${DOCKER_REPO_PREFIX}/pandoc "${args}" "${rfile}"\
}
