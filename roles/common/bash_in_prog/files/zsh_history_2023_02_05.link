: 1646288508:0;\
del_stopped(){\
	local name=$1\
	local state\
	state=$(docker inspect --format "{{.State.Running}}" "$name" 2>/dev/null)\
\
	if [[ "$state" == "false" ]]; then\
		docker rm "$name"\
	else if [[ "$state" == "true" ]]; then\
		docker stop "$name"\
		docker rm "$name"\
	fi\
\
}
: 1646288581:0;\
