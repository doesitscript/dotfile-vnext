: 1647451107:0;# creates an nginx config for a local route
: 1647451108:0;function nginx_config(){\
	server=$1\
	route=$2\
\
	# mkdir -p ~/.nginx/conf.d\
	mkdir -p ~/.nginx/conf.d\
\
	rm -rf "${HOME}/.nginx/conf.d/${server}.conf"\
	cat >"${HOME}/.nginx/conf.d/${server}.conf" <<-EOF\
	upstream ${server} { server ${route}; }\
	server {\
	server_name ${server};\
\
	location / {\
	proxy_pass  http://$\{server\}\;\
	proxy_http_version 1.1;\
	proxy_set_header Upgrade \$http_upgrade;\
	proxy_set_header Connection "upgrade";\
	proxy_set_header Host \$http_host;\
	proxy_set_header X-Forwarded-Proto \$scheme;\
	proxy_set_header X-Forwarded-For \$remote_addr;\
	proxy_set_header X-Forwarded-Port \$server_port;\
	proxy_set_header X-Request-Start \$msec;\
}\
	}\
	EOF\
\
	# restart nginx\
	docker restart nginx\
\
	# add host to /etc/hosts\
	sudo hostess add "$server" 127.0.0.1\
\
	# open browser\
	open "http://${server}"\
	# browser-exec "http://${server}"\
}
