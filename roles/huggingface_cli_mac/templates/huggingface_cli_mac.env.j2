# Managed by Ansible role huggingface_cli_mac
# Default cache/download root for `hf download` (override per command with --local-dir).
export HF_HOME={{ huggingface_cli_mac_hf_home | quote }}
export HUGGINGFACE_HUB_CACHE={{ (huggingface_cli_mac_hf_home ~ '/hub') | quote }}
{% if (huggingface_cli_mac_resolved_hf_token | default('') | length) > 0 %}
# From vault_hf_token (or huggingface_cli_mac_hf_token override). Optional — omit when empty.
export HF_TOKEN={{ huggingface_cli_mac_resolved_hf_token | quote }}
export HUGGINGFACE_HUB_TOKEN={{ huggingface_cli_mac_resolved_hf_token | quote }}
{% endif %}
