# Aider homelab configuration — managed by Ansible (work-laptop packet / parent role).
# Do not edit manually; re-run the packet playbook to regenerate.
#
# Conversion note (Aider 0.86+): use yes-always, never the legacy `yes:` key.
# New files: /add <path> before asking it to write (or aider --read <path> for
# planning). Paths are relative to the Git worktree root. map-tokens indexes the
# repo; it does not automatically expose every file's full contents.
# suggest-shell-commands is off so create/edit goes through apply-edits.

# LiteLLM gateway on homelab
openai-api-key: "{{ aider_render_api_key }}"
openai-api-base: "{{ aider_gateway_api_base }}"
model: "{{ aider_default_model }}"

# Behaviour — write/edit workflow for dirty corporate checkouts
auto-commits: {{ aider_auto_commits | default(false) | bool | lower }}
dirty-commits: {{ aider_dirty_commits | default(true) | bool | lower }}
suggest-shell-commands: {{ aider_suggest_shell_commands | default(false) | bool | lower }}
yes-always: {{ aider_render_yes_always | default(true) | bool | lower }}
git: {{ aider_git | default(true) | bool | lower }}
skip-sanity-check-repo: {{ aider_skip_sanity_check_repo | default(false) | bool | lower }}
map-tokens: {{ aider_map_tokens | default(2048) }}
map-refresh: {{ aider_map_refresh | default('files') }}
stream: true
{% if aider_read_files | default([]) | length > 0 %}
read:
{% for path in aider_read_files %}
  - {{ path | to_json }}
{% endfor %}
{% endif %}
