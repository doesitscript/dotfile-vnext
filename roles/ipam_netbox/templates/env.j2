# This file is managed by Ansible.
# Do not edit this file directly.

# Postgres container credentials (consumed by the postgres container itself)
POSTGRES_DB={{ vault_vars.vault_netbox_db_name }}
POSTGRES_USER={{ vault_vars.vault_netbox_db_user }}
POSTGRES_PASSWORD={{ vault_vars.vault_netbox_db_password }}

# NetBox → Postgres connection (consumed by the netbox app container)
DB_HOST=postgres
DB_NAME={{ vault_vars.vault_netbox_db_name }}
DB_USER={{ vault_vars.vault_netbox_db_user }}
DB_PASSWORD={{ vault_vars.vault_netbox_db_password }}

# Redis (tasks queue and cache)
REDIS_HOST=redis
REDIS_PASSWORD={{ vault_vars.vault_netbox_redis_password }}
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD={{ vault_vars.vault_netbox_redis_password }}

# NetBox application settings
SECRET_KEY={{ vault_vars.vault_netbox_secret_key }}
ALLOWED_HOSTS=*
SUPERUSER_NAME={{ vault_vars.vault_netbox_superuser_name }}
SUPERUSER_EMAIL={{ vault_vars.vault_netbox_superuser_email }}
SUPERUSER_PASSWORD={{ vault_vars.vault_netbox_superuser_password }}
SKIP_SUPERUSER=false
