{% endif %}

# ClickHouse (no auth by default, but password available if needed)
{% if vault_network_clickhouse_password is defined and vault_network_clickhouse_password != 'PLACEHOLDER_REPLACE_WITH_VAULT' %}
CLICKHOUSE_PASSWORD={{ vault_network_clickhouse_password }}
{% endif %}

# MinIO
