# Network Stack Environment Variables
# Generated from vault - DO NOT EDIT MANUALLY
# Rendered by Ansible from vault/shared.vault.yml and vault/network.vault.yml
# File mode 0640 root:docker — readable by members of the docker group for compose ops

COMPOSE_PROJECT_NAME=fuzlang-net

# Postgres
POSTGRES_USER={{ vault_network_postgres_user | default('langfuse') }}
POSTGRES_PASSWORD={{ vault_network_postgres_password | default('Pass@w0rd1') }}
POSTGRES_DB={{ vault_network_postgres_db | default('langfuse') }}

# Redis (no auth by default, but password available if needed)
{% if vault_network_redis_password is defined and vault_network_redis_password | length > 0 %}
REDIS_PASSWORD={{ vault_network_redis_password }}
{% endif %}

# ClickHouse (no auth by default, but password available if needed)
{% if vault_network_clickhouse_password is defined and vault_network_clickhouse_password | length > 0 %}
CLICKHOUSE_PASSWORD={{ vault_network_clickhouse_password }}
{% endif %}

# MinIO
MINIO_ROOT_USER={{ vault_network_minio_root_user | default('minioadmin') }}
MINIO_ROOT_PASSWORD={{ vault_network_minio_root_password | default('Pass@w0rd1') }}

# Langfuse
NEXTAUTH_SECRET={{ vault_network_langfuse_nextauth_secret | default('Pass@w0rd1') }}
SALT={{ vault_network_langfuse_salt | default('Pass@w0rd1') }}
LANGFUSE_PUBLIC_KEY={{ vault_shared_langfuse_public_key | default('lf_pk_Pass@w0rd1') }}
LANGFUSE_SECRET_KEY={{ vault_shared_langfuse_secret_key | default('lf_sk_Pass@w0rd1') }}
MINIO_ACCESS_KEY={{ vault_shared_minio_access_key | default('minioadmin') }}
MINIO_SECRET_KEY={{ vault_shared_minio_secret_key | default('Pass@w0rd1') }}
