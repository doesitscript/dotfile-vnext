services:
  postgres:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - {{ linux_data_root }}/postgres:/var/lib/postgresql/data
    ports:
      - "{{ postgres_exposure | default('127.0.0.1:5432:5432') }}"
    networks:
      - fuzlang_net_net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    volumes:
      - {{ linux_data_root }}/redis:/data
    ports:
      - "{{ redis_exposure | default('127.0.0.1:6379:6379') }}"
    networks:
      - fuzlang_net_net
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  clickhouse:
    image: clickhouse/clickhouse-server:24
    restart: unless-stopped
    volumes:
      - {{ linux_data_root }}/clickhouse:/var/lib/clickhouse
    ports:
      - "{{ clickhouse_http_exposure | default('127.0.0.1:8123:8123') }}"
      - "{{ clickhouse_native_exposure | default('127.0.0.1:9000:9000') }}"
    networks:
      - fuzlang_net_net
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8123/ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  minio:
    image: "{{ stacks_network_minio_image }}:{{ stacks_network_minio_image_tag }}"
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    volumes:
      - {{ linux_data_root }}/minio:/data
    ports:
      - "{{ minio_api_exposure | default('0.0.0.0:9000:9000') }}"
      - "{{ minio_console_exposure | default('0.0.0.0:9001:9001') }}"
    networks:
      - fuzlang_net_net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 10s
      retries: 3

{% if stacks_network_langfuse_compose_enabled | bool %}
  langfuse:
    image: langfuse/langfuse:latest
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
      REDIS_URL: redis://redis:6379
      CLICKHOUSE_URL: http://clickhouse:8123
      NEXTAUTH_SECRET: ${NEXTAUTH_SECRET}
      SALT: ${SALT}
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      MINIO_ACCESS_KEY: ${MINIO_ACCESS_KEY}
      MINIO_SECRET_KEY: ${MINIO_SECRET_KEY}
      MINIO_ENDPOINT: http://minio:9000
    volumes:
      - {{ linux_data_root }}/langfuse:/app/packages/database/data
    ports:
      - "{{ langfuse_exposure | default('0.0.0.0:3000:3000') }}"
    networks:
      - fuzlang_net_net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/public/health"]
      interval: 30s
      timeout: 10s
      retries: 3
{% endif %}

networks:
  fuzlang_net_net:
    name: fuzlang_net_net
    driver: bridge
