# {{ ansible_managed }}
# Per-cluster kubeconfigs for kubectl / k9s / stern / gonzo.
# Prefer separate files over a merged ~/.kube/config so other tools cannot
# clobber the managed merge. Switch contexts with:
#   kubectl config use-context <name>
#   kubectx <name>   # if installed
{% if k3s_mac_client_managed_kubeconfigs | default([]) | length > 0 %}
export KUBECONFIG="{{ k3s_mac_client_managed_kubeconfigs | join(':') }}"
{% endif %}
