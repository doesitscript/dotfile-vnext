@echo off
REM Ansible-managed Automatic1111 launcher for Open WebUI image generation.
set PYTHON={{ windows_automatic1111_python_exe }}
set VENV_DIR={{ windows_automatic1111_install_root }}\venv
REM Upstream Stability-AI/stablediffusion is gone (404); use community mirror.
set STABLE_DIFFUSION_REPO={{ windows_automatic1111_stable_diffusion_repo }}
set COMMANDLINE_ARGS={{ windows_automatic1111_commandline_args }}
cd /d "{{ windows_automatic1111_install_root }}"
echo. | call webui.bat >> "{{ windows_automatic1111_contract_root }}\webui.log" 2>&1
