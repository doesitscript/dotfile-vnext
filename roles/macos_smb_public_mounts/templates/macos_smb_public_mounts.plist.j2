<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ macos_smb_public_mounts_launch_agent_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{ macos_smb_public_mounts_mount_script }}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>{{ macos_smb_public_mounts_support_dir }}/mount.log</string>
  <key>StandardErrorPath</key>
  <string>{{ macos_smb_public_mounts_support_dir }}/mount.err</string>
</dict>
</plist>
