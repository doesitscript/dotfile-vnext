---
# Example only — copy to shared.vault.yml and encrypt. Do not commit secrets.
# Key names must match what each MCP role's load_vault.yml reads.

# Morph (roles/mcp_servers/morph)
vault_shared_morph_api_key: "REPLACE_ME"

# Firecrawl (roles/mcp_servers/firecrawl)
vault_firecrawl_mcp_api_key: "REPLACE_ME"

# Context7 (roles/mcp_servers/context7) — optional for higher quotas
vault_context7_mcp_api_key: "REPLACE_ME"

# Firebase (roles/mcp_servers/firebase)
vault_firebase_mcp_service_account_json: ""
vault_firebase_mcp_firebase_token: ""
# vault_firebase_mcp_extra_env: {}

# Continue / Zed LiteLLM gateway (roles/continue_ide, roles/zed_ide)
vault_k3s_litellm_gateway_master_key: "REPLACE_ME"
