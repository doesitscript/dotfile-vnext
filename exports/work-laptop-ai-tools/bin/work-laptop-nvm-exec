#!/usr/bin/env bash
# Run an MCP/Node binary with nvm loaded. VS Code / Continue GUI PATH often
# lacks ~/.nvm/*/bin, so Continue stdio servers must not assume `morph-mcp`
# or `npx` are on PATH.
#
# Also prepend `npm prefix -g`/bin when ~/.npmrc sets a custom prefix
# (e.g. ~/.npm-packages). Without that, globals install away from nvm's bin
# and shims like context7-mcp / morph-mcp / codex are invisible to GUI clients.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: work-laptop-nvm-exec <command> [args...]" >&2
  exit 64
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"
fi

if command -v npm >/dev/null 2>&1; then
  _npm_prefix="$(npm prefix -g 2>/dev/null || true)"
  if [[ -n "${_npm_prefix}" && -d "${_npm_prefix}/bin" ]]; then
    export PATH="${_npm_prefix}/bin:${PATH}"
  fi
  unset _npm_prefix
fi

exec "$@"
