#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: mcp-server-env-wrapper <env-file> <command> [args...]" >&2
  exit 64
fi

env_file="$1"
shift

if [[ ! -r "$env_file" ]]; then
  echo "MCP env file is not readable: $env_file" >&2
  exit 66
fi

set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

exec "$@"
